FROM debian:bookworm-slim

ARG PYMAVLINK_VERSION=2.4.49

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential cmake ninja-build pkg-config \
       python3 python3-dev python3-pip nlohmann-json3-dev libgpiod-dev \
    && rm -rf /var/lib/apt/lists/*

# The source distribution includes the XML definitions; the wheel does not.
RUN python3 -m pip install --break-system-packages --no-cache-dir \
      --no-binary=pymavlink "pymavlink==${PYMAVLINK_VERSION}" \
    && mkdir -p /opt/mavlink/pymavlink/tools /opt/mavlink/message_definitions \
    && cp /usr/local/bin/mavgen.py /opt/mavlink/pymavlink/tools/mavgen.py \
    && python3 -c "from pathlib import Path; import pymavlink; Path('/opt/mavlink/message_definitions/v1.0').symlink_to(Path(pymavlink.__file__).parent / 'message_definitions/v1.0')"

WORKDIR /work/onboard_executor

CMD ["sh", "-lc", "cmake -S . -B build -G Ninja -DFFTGYRO_MAVLINK_ROOT=/opt/mavlink && cmake --build build && ctest --test-dir build --output-on-failure"]
