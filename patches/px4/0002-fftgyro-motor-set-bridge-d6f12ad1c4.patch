+    <enum name="FFTGYRO_MOTOR_ACTION">
+      <description>Action requested by an FFTGYRO_MOTOR_SET message.</description>
+      <entry value="0" name="FFTGYRO_MOTOR_ACTION_CONTROL">
+        <description>Apply all four motor values with the supplied timeout.</description>
+      </entry>
+      <entry value="1" name="FFTGYRO_MOTOR_ACTION_RELEASE">
+        <description>Release actuator-test control for all four motors.</description>
+      </entry>
+    </enum>
+    <enum name="FFTGYRO_MOTOR_SET_STATUS">
+      <description>Result of validating and queueing one four-motor set.</description>
+      <entry value="0" name="FFTGYRO_MOTOR_SET_STATUS_ACCEPTED">
+        <description>All four actuator-test entries were accepted and queued.</description>
+      </entry>
+      <entry value="1" name="FFTGYRO_MOTOR_SET_STATUS_RELEASED">
+        <description>Release entries for all four motors were queued.</description>
+      </entry>
+      <entry value="2" name="FFTGYRO_MOTOR_SET_STATUS_REJECTED_VALUE">
+        <description>At least one motor value was non-finite or outside the permitted range.</description>
+      </entry>
+      <entry value="3" name="FFTGYRO_MOTOR_SET_STATUS_REJECTED_TIMEOUT">
+        <description>The requested timeout was outside the permitted range.</description>
+      </entry>
+      <entry value="4" name="FFTGYRO_MOTOR_SET_STATUS_REJECTED_UNSAFE">
+        <description>The vehicle state did not permit actuator testing.</description>
+      </entry>
+      <entry value="5" name="FFTGYRO_MOTOR_SET_STATUS_REJECTED_SEQUENCE">
+        <description>The sequence number was duplicated or older than the accepted sequence.</description>
+      </entry>
+      <entry value="6" name="FFTGYRO_MOTOR_SET_STATUS_REJECTED_RUN">
+        <description>The run identifier was zero, expired, released, killed, or did not start at sequence zero.</description>
+      </entry>
+    </enum>
+  </enums>
+  <messages>
+    <message id="60000" name="FFTGYRO_MOTOR_SET">
+      <description>One atomic four-motor actuator-test request generated by the onboard FFTGYRO experiment executor.</description>
+      <field type="uint32_t" name="run_id">Non-zero identifier generated once for each executor run.</field>
+      <field type="uint32_t" name="sequence">Monotonically increasing set number, starting at zero for a new run.</field>
+      <field type="float[4]" name="motor">Normalized Motor 1 through Motor 4 commands.</field>
+      <field type="uint16_t" name="timeout_ms" units="ms">PX4 actuator-test timeout. CONTROL permits 50 through 500 ms.</field>
+      <field type="uint8_t" name="target_system">System ID of the target autopilot.</field>
+      <field type="uint8_t" name="target_component">Component ID of the target autopilot.</field>
+      <field type="uint8_t" name="action" enum="FFTGYRO_MOTOR_ACTION">Requested control or release action.</field>
+    </message>
+    <message id="60001" name="FFTGYRO_MOTOR_SET_ACK">
+      <description>Acceptance or rejection of one FFTGYRO_MOTOR_SET. ACCEPTED means queued, not physically emitted by DShot.</description>
+      <field type="uint64_t" name="rx_time_us" units="us">PX4 monotonic time at which the set was validated.</field>
+      <field type="uint32_t" name="run_id">Run identifier copied from the request.</field>
+      <field type="uint32_t" name="sequence">Sequence copied from the request.</field>
+      <field type="uint8_t" name="target_system">System ID of the executor that sent the request.</field>
+      <field type="uint8_t" name="target_component">Component ID of the executor that sent the request.</field>
+      <field type="uint8_t" name="status" enum="FFTGYRO_MOTOR_SET_STATUS">Request result.</field>
+    </message>
+  </messages>
+</mavlink>
