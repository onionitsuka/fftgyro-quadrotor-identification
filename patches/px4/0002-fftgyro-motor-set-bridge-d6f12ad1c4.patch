+#if defined(MAVLINK_MSG_ID_FFTGYRO_MOTOR_SET)
+bool
+MavlinkReceiver::fftgyro_run_was_terminated(uint32_t run_id) const
+{
+	for (const uint32_t terminated_run_id : _fftgyro_terminated_run_ids) {
+		if (run_id != 0 && run_id == terminated_run_id) {
+			return true;
+		}
+	}
+
+	return false;
+}
+
+void
+MavlinkReceiver::terminate_fftgyro_run(uint32_t run_id)
+{
+	if (run_id == 0 || fftgyro_run_was_terminated(run_id)) {
+		return;
+	}
+
+	_fftgyro_terminated_run_ids[_fftgyro_terminated_run_index] = run_id;
+	_fftgyro_terminated_run_index =
+		(_fftgyro_terminated_run_index + 1) % (sizeof(_fftgyro_terminated_run_ids) / sizeof(_fftgyro_terminated_run_ids[0]));
+
+	if (_fftgyro_active_run_id == run_id) {
+		_fftgyro_active_run_id = 0;
+	}
+}
+
+void
+MavlinkReceiver::send_fftgyro_motor_set_ack(const mavlink_message_t *msg,
+		const mavlink_fftgyro_motor_set_t &request,
+		uint8_t status,
+		hrt_abstime now)
+{
+	constexpr size_t ack_size = MAVLINK_MSG_ID_FFTGYRO_MOTOR_SET_ACK_LEN + MAVLINK_NUM_NON_PAYLOAD_BYTES;
+
+	if (_mavlink.get_free_tx_buf() >= ack_size) {
+		mavlink_fftgyro_motor_set_ack_t ack{};
+		ack.rx_time_us = now;
+		ack.run_id = request.run_id;
+		ack.sequence = request.sequence;
+		ack.target_system = msg->sysid;
+		ack.target_component = msg->compid;
+		ack.status = status;
+		mavlink_msg_fftgyro_motor_set_ack_send_struct(_mavlink.get_channel(), &ack);
+	}
+}
+
+void
+MavlinkReceiver::handle_message_fftgyro_motor_set(mavlink_message_t *msg)
+{
+	mavlink_fftgyro_motor_set_t request{};
+	mavlink_msg_fftgyro_motor_set_decode(msg, &request);
+
+	if (!evaluate_target_ok(0, request.target_system, request.target_component)) {
+		return;
+	}
+
+	const hrt_abstime now = hrt_absolute_time();
+
+	if (_fftgyro_active_run_id != 0 && now > _fftgyro_run_deadline) {
+		terminate_fftgyro_run(_fftgyro_active_run_id);
+	}
+
+	if (request.action == FFTGYRO_MOTOR_ACTION_RELEASE) {
+		if (request.run_id != 0
+		    && request.run_id == _fftgyro_active_run_id
+		    && request.sequence > _fftgyro_last_sequence) {
+			if (!_actuator_test_pub.advertise()) {
+				terminate_fftgyro_run(request.run_id);
+				send_fftgyro_motor_set_ack(msg, request, FFTGYRO_MOTOR_SET_STATUS_REJECTED_UNSAFE, now);
+				return;
+			}
+
+			actuator_test_s actuator_test{};
+			actuator_test.timestamp = now;
+			actuator_test.action = actuator_test_s::ACTION_RELEASE_CONTROL;
+
+			for (int motor = 0; motor < 4; ++motor) {
+				actuator_test.function = actuator_test_s::FUNCTION_MOTOR1 + motor;
+				_actuator_test_pub.publish(actuator_test);
+			}
+
+			terminate_fftgyro_run(_fftgyro_active_run_id);
+			send_fftgyro_motor_set_ack(msg, request, FFTGYRO_MOTOR_SET_STATUS_RELEASED, now);
+
+		} else {
+			send_fftgyro_motor_set_ack(msg, request, FFTGYRO_MOTOR_SET_STATUS_REJECTED_RUN, now);
+		}
+
+		return;
+	}
+
+	if (request.action != FFTGYRO_MOTOR_ACTION_CONTROL) {
+		send_fftgyro_motor_set_ack(msg, request, FFTGYRO_MOTOR_SET_STATUS_REJECTED_VALUE, now);
+		return;
+	}
+
+	for (float value : request.motor) {
+		if (!PX4_ISFINITE(value) || value < 0.f || value > 1.f) {
+			send_fftgyro_motor_set_ack(msg, request, FFTGYRO_MOTOR_SET_STATUS_REJECTED_VALUE, now);
+			return;
+		}
+	}
+
+	if (request.timeout_ms < 50 || request.timeout_ms > 500) {
+		send_fftgyro_motor_set_ack(msg, request, FFTGYRO_MOTOR_SET_STATUS_REJECTED_TIMEOUT, now);
+		return;
+	}
+
+	actuator_armed_s actuator_armed{};
+	vehicle_status_s vehicle_status{};
+	const bool state_available = _actuator_armed_sub.copy(&actuator_armed)
+				     && _vehicle_status_sub.copy(&vehicle_status);
+	const bool unsafe = !state_available
+			    || actuator_armed.armed
+			    || actuator_armed.lockdown
+			    || actuator_armed.kill
+			    || actuator_armed.termination
+			    || (vehicle_status.safety_button_available && !vehicle_status.safety_off)
+			    || !_param_com_mot_test_en.get();
+
+	if (unsafe) {
+		terminate_fftgyro_run(request.run_id);
+		send_fftgyro_motor_set_ack(msg, request, FFTGYRO_MOTOR_SET_STATUS_REJECTED_UNSAFE, now);
+		return;
+	}
+
+	if (_fftgyro_active_run_id == 0) {
+		if (request.run_id == 0
+		    || fftgyro_run_was_terminated(request.run_id)
+		    || request.sequence != 0) {
+			send_fftgyro_motor_set_ack(msg, request, FFTGYRO_MOTOR_SET_STATUS_REJECTED_RUN, now);
+			return;
+		}
+
+		_fftgyro_active_run_id = request.run_id;
+		_fftgyro_last_sequence = 0;
+
+	} else if (request.run_id != _fftgyro_active_run_id) {
+		send_fftgyro_motor_set_ack(msg, request, FFTGYRO_MOTOR_SET_STATUS_REJECTED_RUN, now);
+		return;
+
+	} else if (request.sequence <= _fftgyro_last_sequence) {
+		send_fftgyro_motor_set_ack(msg, request, FFTGYRO_MOTOR_SET_STATUS_REJECTED_SEQUENCE, now);
+		return;
+	}
+
+	actuator_test_s actuator_test{};
+	actuator_test.timestamp = now;
+	actuator_test.action = actuator_test_s::ACTION_DO_CONTROL;
+	actuator_test.timeout_ms = request.timeout_ms;
+
+	if (!_actuator_test_pub.advertise()) {
+		terminate_fftgyro_run(request.run_id);
+		send_fftgyro_motor_set_ack(msg, request, FFTGYRO_MOTOR_SET_STATUS_REJECTED_UNSAFE, now);
+		return;
+	}
+
+	for (int motor = 0; motor < 4; ++motor) {
+		actuator_test.function = actuator_test_s::FUNCTION_MOTOR1 + motor;
+		actuator_test.value = request.motor[motor];
+		_actuator_test_pub.publish(actuator_test);
+	}
+
+	_fftgyro_last_sequence = request.sequence;
+	_fftgyro_run_deadline = now + request.timeout_ms * 1000;
+	send_fftgyro_motor_set_ack(msg, request, FFTGYRO_MOTOR_SET_STATUS_ACCEPTED, now);
+}
+#endif
